HOST=127.0.0.1
PORT=8080
PUBLIC_ORIGIN=http://127.0.0.1:8080
DATA_DIR=./var/okei
COOKIE_SECURE=false
# Set credentials only in your private .env before running setup:staff.
STAFF_LOGIN=
STAFF_PASSWORD=
STAFF_NAME=

# Production: HTTPS PUBLIC_ORIGIN, NODE_ENV=production; reverse proxy preserves Host.
NODE_ENV=development
SERVER_ONLY=true
# Trust only the actual proxy IP/CIDR; never use true for an Internet-facing port.
TRUST_PROXY=
BACKUP_DIR=./var/backups
USER_STORAGE_MB=256
TOTAL_STORAGE_MB=2048
MAX_USER_ORDERS=200
MAX_ORDERS=2000
MAX_USERS=500
